{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pwps.dev/schema/pwps-0.1.schema.json",
  "title": "PWPS 0.1 — Physical Workflow Protocol Specification",
  "description": "Structural schema for PWPS 0.1 documents (Linear Verification Profile). Semantic rules (references, contradictions, cycles) are enforced by the PWPS semantic validator, not by this schema.",
  "type": "object",
  "required": ["pwps", "protocol", "states", "constraints"],
  "additionalProperties": false,
  "properties": {
    "pwps": {
      "type": "string",
      "description": "PWPS specification version understood by this document.",
      "const": "0.1"
    },
    "protocol": {
      "type": "object",
      "required": ["id", "version", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/protocolId" },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 }
      }
    },
    "metadata": { "type": "object" },
    "zones": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/semanticId" },
          "name": { "type": "string", "maxLength": 200 },
          "description": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/semanticId" },
          "name": { "type": "string", "maxLength": 200 },
          "required": { "type": "boolean" },
          "terminal": { "type": "boolean" },
          "zone": { "$ref": "#/definitions/semanticId" },
          "description": { "type": "string", "maxLength": 4000 },
          "metadata": { "type": "object" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/ruleId" },
          "from": { "$ref": "#/definitions/semanticId" },
          "to": { "$ref": "#/definitions/semanticId" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/definitions/constraint" }
    },
    "evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["state"],
        "additionalProperties": false,
        "properties": {
          "state": { "$ref": "#/definitions/semanticId" },
          "required": { "type": "boolean" },
          "zone": { "$ref": "#/definitions/semanticId" },
          "accepted_authority": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          }
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambiguous_ordering": { "const": "NOT_EVALUABLE" },
        "required_state_unresolved": { "const": "NOT_EVALUABLE" },
        "source_coverage_gap": { "const": "NOT_EVALUABLE" }
      }
    },
    "failure_conditions": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["id", "constraint_ref"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/ruleId" },
          "description": { "type": "string", "maxLength": 4000 },
          "constraint_ref": { "$ref": "#/definitions/ruleId" }
        }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Vendor/application-specific data. Consumers MUST be able to ignore unknown extensions; core semantics MUST NOT depend on them."
    }
  },
  "definitions": {
    "protocolId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "semanticId": {
      "type": "string",
      "description": "Lowercase, stable, machine-readable identifier without spaces.",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$"
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+(\\.\\d{1,3})?S)?)?$"
    },
    "constraint": {
      "type": "object",
      "required": ["id", "operator"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/ruleId" },
        "operator": { "enum": ["REQUIRED", "BEFORE", "AFTER", "WITHIN", "FORBIDDEN"] },
        "description": { "type": "string", "maxLength": 4000 },
        "severity": { "enum": ["MANDATORY", "ADVISORY"] },
        "state": { "$ref": "#/definitions/semanticId" },
        "reference": { "$ref": "#/definitions/semanticId" },
        "after": { "$ref": "#/definitions/semanticId" },
        "duration": { "$ref": "#/definitions/duration" },
        "transition": {
          "type": "object",
          "required": ["from", "to"],
          "additionalProperties": false,
          "properties": {
            "from": { "$ref": "#/definitions/semanticId" },
            "to": { "$ref": "#/definitions/semanticId" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operator": { "const": "REQUIRED" } }, "required": ["operator"] },
          "then": { "required": ["state"] }
        },
        {
          "if": { "properties": { "operator": { "const": "BEFORE" } }, "required": ["operator"] },
          "then": { "required": ["state", "reference"] }
        },
        {
          "if": { "properties": { "operator": { "const": "AFTER" } }, "required": ["operator"] },
          "then": { "required": ["state", "reference"] }
        },
        {
          "if": { "properties": { "operator": { "const": "WITHIN" } }, "required": ["operator"] },
          "then": { "required": ["state", "after", "duration"] }
        },
        {
          "if": { "properties": { "operator": { "const": "FORBIDDEN" } }, "required": ["operator"] },
          "then": {
            "oneOf": [
              { "required": ["transition"], "not": { "required": ["state"] } },
              { "required": ["state"], "not": { "required": ["transition"] } }
            ]
          }
        }
      ]
    }
  }
}
