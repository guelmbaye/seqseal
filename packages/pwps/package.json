{
  "name": "@pwps/core",
  "version": "0.1.0",
  "description": "PWPS — Physical Workflow Protocol Specification. A vendor-neutral specification and toolchain for evidence-verifiable physical workflows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guelmbaye/seqseal.git",
    "directory": "packages/pwps"
  },
  "homepage": "https://github.com/guelmbaye/seqseal/tree/main/packages/pwps#readme",
  "bugs": "https://github.com/guelmbaye/seqseal/issues",
  "type": "module",
  "keywords": [
    "pwps",
    "physical-workflow",
    "protocol",
    "verification",
    "specification",
    "sop"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schema/pwps-0.1.schema.json"
  },
  "bin": {
    "pwps": "./bin/pwps.mjs"
  },
  "files": [
    "bin",
    "dist",
    "schema",
    "examples",
    "conformance",
    "SPEC.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./schema": "./schema/pwps-0.1.schema.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "pwps": "tsx src/cli.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
