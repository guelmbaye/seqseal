# ─────────────────────────────────────────────────────────────
# SEQSEAL — environment configuration (copy to .env / .env.local)
# Never commit real secrets. Production secrets live in AWS Secrets Manager.
# ─────────────────────────────────────────────────────────────

# Web backend: "local" runs the full pipeline in-process (judge fast path),
# "remote" reads from the deployed read-api.
SEQSEAL_BACKEND=local
SEQSEAL_API_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com
SEQSEAL_DEMO_TOKEN=change-me-demo-token

# Demo safety switch: stable protocol/policy/bindings + replay controls.
# Never hard-codes verdicts.
DEMO_MODE=true

# Feature flags (Doc 06 §122)
# Bedrock media interpretation (AWS only; the local demo uses the deterministic mock interpreter)
ENABLE_BEDROCK_EVIDENCE=false
# Kill switch: when true, Bedrock is never called whatever the other flags say (hero A/B never needs it)
BEDROCK_DISABLED=true
# Reserved by the specification, not implemented in this build (docs/BUILD_NOTES.md BN-014):
# ENABLE_AGENTCORE=false
# ENABLE_RECONCILIATION=false
# ENABLE_PUSH_UPDATES=false

# Finalization grace window before a SEALED/DEVIATED execution is finalized
FINALIZATION_GRACE_SECONDS=0

# Ring Developer Platform (Ring Partner API) — see docs/RING_INTEGRATION.md
RING_API_BASE_URL=https://api.amazonvision.com
RING_OAUTH_URL=https://oauth.ring.com/oauth/token
# Developer Playground short-lived token (never commit)
RING_PLAYGROUND_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# Webhook HMAC signing key (local testing only; AWS reads Secrets Manager)
RING_WEBHOOK_SIGNING_SECRET=local-dev-signing-secret

# AWS (deployed services receive these from Terraform)
AWS_REGION=us-east-1
SEQSEAL_EVENT_BUS=seqseal-events
SEQSEAL_TABLE_EXECUTIONS=seqseal-demo-executions
SEQSEAL_TABLE_EVIDENCE=seqseal-demo-evidence
SEQSEAL_TABLE_CONFIG=seqseal-demo-config
SEQSEAL_TABLE_IDEMPOTENCY=seqseal-demo-idempotency
SEQSEAL_ARTIFACT_BUCKET=seqseal-demo-artifacts
BEDROCK_EVIDENCE_MODEL_ID=
